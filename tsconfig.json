{
  // Vérification de types progressive du code navigateur : seuls les fichiers qui commencent par
  // « // @ts-check » sont contrôlés (types tirés du code et des commentaires JSDoc).
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "src/types.d.ts"]
}
