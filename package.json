    "@fontsource/b612-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
