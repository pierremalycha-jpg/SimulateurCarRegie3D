  "description": "Simulateur 3D de car régie pour la formation des techniciens",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:dev": "node tools/build.mjs --dev",
    "exe": "node tools/build.mjs && node tools/exe.mjs",
